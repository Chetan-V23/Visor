{
  "name": "visor",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "pnpm --filter hook build && pnpm --filter desktop build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "pnpm --filter hook build && vitest run",
    "setup:hooks": "pnpm build && node apps/hook/dist/install.js",
    "test:ui": "pnpm build && playwright test",
    "test": "pnpm test:unit && pnpm test:ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  }
}
              },
              {
                "kind": "added",
                "text": "class NiftiImage:\r"
              },
              {
                "kind": "added",
                "text": "    def __init__(self, path: str | Path):\r"
              },
              {
                "kind": "added",
                "text": "        self.path = Path(path)\r"
              },
              {
                "kind": "added",
                "text": "        self.image = nib.load(self.path)\r"
              },
              {
                "kind": "added",
                "text": "        self.data: np.ndarray = self.image.get_fdata()\r"
              },
              {
                "kind": "added",
                "text": "\r"
              },
              {
                "kind": "added",
                "text": "    @property\r"
              },
              {
                "kind": "added",
                "text": "    def name(self) -> str:\r"
              },
              {
                "kind": "added",
                "text": "        return self.path.name\r"
              },
              {
                "kind": "added",
                "text": "\r"
              },
              {
                "kind": "added",
                "text": "    @property\r"
              },
              {
                "kind": "added",
                "text": "    def shape(self) -> tuple[int, ...]:\r"
              },
              {
                "kind": "added",
                "text": "        return self.data.shape\r"
              },
              {
                "kind": "added",
                "text": "\r"
              },
              {
                "kind": "added",
                "text": "\r"
              },
              {
                "kind": "context",
                "text": "class Main:\r"
              },
              {
                "kind": "context",
                "text": "    IMAGE_A_PATH = Path(r\"<path>\")\r"
              },
              {
                "kind": "context",
                "text": "    IMAGE_B_PATH = Path(r\"<path>\")\r"
              },
              {
                "kind": "context",
                "text": "\r"
              }
            ]
          },
          {
            "oldStart": 34,
            "oldLines": 8,
            "newStart": 50,
            "newLines": 35,
            "lines": [
              {
                "kind": "context",
                "text": "            ax.axis(\"off\")\r"
              },
              {
                "kind": "context",
                "text": "        plt.tight_layout()\r"
              },
              {
                "kind": "context",
                "text": "        plt.show()\r"
              },
              {
                "kind": "context",
                "text": "\r"
              },
              {
                "kind": "added",
                "text": "    def compare_nifti(\r"
              },
              {
                "kind": "added",
                "text": "        self,\r"
              },
              {
                "kind": "added",
                "text": "        image_a_path: str | Path,\r"
              },
              {
                "kind": "added",
                "text": "        image_b_path: str | Path,\r"
              },
              {
                "kind": "added",
                "text": "        slice_index: int | None = None,\r"
              },
              {
                "kind": "added",
                "text": "    ) -> None:\r"
              },
              {
                "kind": "added",
                "text": "        images = (NiftiImage(image_a_path), NiftiImage(image_b_path))\r"
              },
              {
                "kind": "added",
                "text": "        slices = []\r"
              },
              {
                "kind": "added",
                "text": "        for image in images:\r"
              },
              {
                "kind": "added",
                "text": "            if image.data.ndim == 2:\r"
              },
              {
                "kind": "added",
                "text": "                slices.append(image.data)\r"
              },
              {
                "kind": "added",
                "text": "            elif image.data.ndim == 3:\r"
              },
              {
                "kind": "added",
                "text": "                index = image.shape[2] // 2 if slice_index is None else slice_index\r"
              },
              {
                "kind": "added",
                "text": "                if not 0 <= index < image.shape[2]:\r"
              },
              {
                "kind": "added",
                "text": "                    raise ValueError(f\"Slice index {index} is out of bounds for {image.name}\")\r"
              },
              {
                "kind": "added",
                "text": "                slices.append(image.data[:, :, index])\r"
              },
              {
                "kind": "added",
                "text": "            else:\r"
              },
              {
                "kind": "added",
                "text": "                raise ValueError(f\"Expected a 2D or 3D NIfTI image: {image.name} {image.shape}\")\r"
              },
              {
                "kind": "added",
                "text": "\r"
              },
              {
                "kind": "added",
                "text": "        fig, axes = plt.subplots(1, 2, figsize=(12, 6))\r"
              },
              {
                "kind": "added",
                "text": "        for ax, image, data in zip(axes, images, slices):\r"
              },
              {
                "kind": "added",
                "text": "            ax.imshow(data, cmap=\"gray\")\r"
              },
              {
                "kind": "added",
                "text": "            ax.set_title(f\"{image.name} {image.shape}\")\r"
              },
              {
                "kind": "added",
                "text": "            ax.axis(\"off\")\r"
              },
              {
                "kind": "added",
                "text": "        plt.tight_layout()\r"
              },
              {
                "kind": "added",
                "text": "        plt.show()\r"
              },
              {
                "kind": "added",
                "text": "\r"
              },
              {
                "kind": "context",
                "text": "    def run(self) -> None:\r"
              },
              {
                "kind": "context",
                "text": "        self.compare()\r"
              },
              {
                "kind": "context",
                "text": "\r"
              },
